{
  "name": "dsh-alibaba-mcp",
  "version": "0.3.0",
  "description": "Connect the local Alibaba Cloud Ops MCP server to DeepSeek Harness. Access keys stay in credentials and are passed only to that stdio process.",
  "license": "MIT",
  "author": "NingYuanLee <liyunningyuan@outlook.com>",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "README*.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/launch.js && node --check src/client.js && node --check scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "alibaba-cloud",
    "mcp"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-settings-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
